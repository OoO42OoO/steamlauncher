# Local HTTP/WS server (127.0.0.1 only).
# SERVER_TOKEN is generated at runtime (crypto.randomBytes) and never committed.
# If you need a stable token for local dev, set it here; otherwise leave unset.
SERVER_PORT=38721
# SERVER_TOKEN=

# DepotDownloader binary (optional override).
#
# In packaged builds the binary ships under `resources/vendor/<plat>-x64/`
# automatically and this var should stay unset. Setting it forces a
# different binary — useful for testing a newer DD version without rebuild.
#
# In `pnpm dev` the resolver also looks at `vendor/{linux-x64,win-x64}/` in
# the repo, so dev-mode runs work without DEPOTDOWNLOADER_PATH too.
#
# Get the binary at https://github.com/SteamRE/DepotDownloader/releases
# (current pinned version: v3.4.0).
# DEPOTDOWNLOADER_PATH=/opt/DepotDownloader/DepotDownloader

# Remote API base URL (no trailing slash).
# Deployment configuration — the real host is not kept in the repository.
API_BASE_URL=https://api.example.invalid

# Network timeouts / intervals.
API_TIMEOUT_MS=15000
METRICS_FLUSH_INTERVAL_MS=60000

# Dev-only: stub out POST /auth-codes/{code}/redeem until backend ships it.
# Has no effect in production builds.
FAKE_REDEEM=0

# Logging. Verbose only for local dev. In prod stays at 'warn'.
LOG_LEVEL=debug

