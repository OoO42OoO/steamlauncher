# Auto-updater feed (electron-updater).
# Base URL where release artifacts + latest.yml are published.
# Stub for now — actual electron-updater wiring lands later.
# Deployment configuration — the real host is not kept in the repository.
# Required at BUILD time: it is inlined into the app and written into
# electron-builder's publish block.
STEAM_CLIENT_UPDATES_URL=https://updates.example.invalid/release

# Diagnostic logging master switch. "true" writes electron-log output to
# %APPDATA%\steam-client\logs and the console; anything else (the prod
# default) silences every transport so nothing is written to disk. Flip
# to true for local debugging.
STEAM_CLIENT_LOGGING=false
